# General URLs
KANEO_CLIENT_URL=http://localhost:5173
# KANEO_API_URL=http://localhost:1337      # optional - defaults to KANEO_CLIENT_URL/api
# KANEO_INTERNAL_API_URL=http://127.0.0.1:1337 # optional - internal MCP tool requests only
# CORS_ORIGINS=                            # optional - comma-separated; defaults to KANEO_CLIENT_URL

# Database
# DATABASE_URL=                            # optional: use this for host-native or external DB access
POSTGRES_DB=kaneo
POSTGRES_USER=kaneo
POSTGRES_PASSWORD=
# POSTGRES_HOST=postgres                   # Compose container default; use localhost for host-native API startup
# POSTGRES_PORT=5432
# Note: POSTGRES_DB and POSTGRES_USER alone do not enable derived connection mode.
# Derived DATABASE_URL is only used when POSTGRES_PASSWORD or an explicit host/port is set.

# File storage
# Leave STORAGE_BACKEND unset to keep using S3 (the historical default).
# STORAGE_BACKEND=s3
# STORAGE_MAX_UPLOAD_BYTES=10485760        # optional - applies to every backend; falls back to S3_MAX_IMAGE_UPLOAD_BYTES
# STORAGE_UPLOAD_URL_TTL_SECONDS=300       # optional - upload credential lifetime; falls back to S3_PRESIGN_TTL_SECONDS

# Local disk storage: for single-instance deployments without object storage.
# STORAGE_BACKEND=local
# LOCAL_STORAGE_PATH=/app/apps/api/data/uploads
# LOCAL_STORAGE_PATH must be absolute and writable, and must point at a
# persistent volume - the container writable layer is not durable, and a
# temporary directory would lose every upload on restart.
# LOCAL_UPLOAD_TEMP_TTL_SECONDS=3600       # optional - grace period before abandoned upload parts are removed

# S3-compatible object storage (used when STORAGE_BACKEND is "s3" or unset)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_KEY_PREFIX=
# S3_MAX_IMAGE_UPLOAD_BYTES=10485760
# S3_PRESIGN_TTL_SECONDS=300

# Redis Pub/Sub for WebSockets (Optional) -> auto fallback to in memory
# Only one mode should be configured. Priority: Cluster > Sentinel > Standalone.

# Standalone
#REDIS_URL=

# Sentinel
#REDIS_SENTINELS=
#REDIS_SENTINEL_MASTER_NAME=mymaster
#REDIS_SENTINEL_PASSWORD=
#REDIS_SENTINEL_TLS=false

# Cluster
#REDIS_CLUSTER_NODES=

# Shared (Sentinel & Cluster)
#REDIS_PASSWORD=

# Authentication
# Generate with: openssl rand -hex 32
# If unset, a random secret is generated at startup (sessions won't survive restarts)
AUTH_SECRET=

# GitHub SSO (Sign in with GitHub, OAuth App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Legacy fallback for SSO (used only if GITHUB_OAUTH_* are unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub integration (GitHub App: repository sync, webhooks)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=
# When SMTP is configured, sign-in uses email verification codes by default.
# Set to true to use email/password sign-in instead (invitations still use SMTP).
#DISABLE_EMAIL_OTP_SIGN_IN=false

# Cloud-mode abuse mitigations (only enable on hosted multi-tenant instances).
# When KANEO_CLOUD=true: signup with disposable-email providers is blocked,
# Turnstile is required on /sign-up/email, guest accounts cannot send
# workspace invites, and per-IP rate limits apply to signup + invite paths.
#KANEO_CLOUD=false

# Cloudflare Turnstile (signup captcha). Set the secret key to enforce;
# leave unset to skip verification (self-hosted).
#TURNSTILE_SECRET_KEY=
# Web container: the production image bakes "KANEO_TURNSTILE_SITE_KEY" as a
# placeholder and apps/web/env.sh substitutes it at container start from this
# env var. For local dev (vite), set VITE_TURNSTILE_SITE_KEY in apps/web/.env.
#KANEO_TURNSTILE_SITE_KEY=

# Sentry error tracking (Optional): errors are only reported when a DSN is set
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1         # 0.0 disables; default 0 (opt-in)
# SENTRY_PROFILES_SAMPLE_RATE=0.1      # 0.0 disables; default 0 (opt-in)
# SENTRY_RELEASE=                       # git SHA; ties events to source maps. Falls back to package.json version.
# SENTRY_API_TOKEN=                     # Used by scripts/provision-sentry-alerts.sh and scripts/provision-sentry-dashboards.sh. Scope: org:write. https://sentry.io/settings/account/api/auth-tokens/

# Kaneo Cloud billing via Creem (Optional): only active when KANEO_CLOUD=true
# and both keys are set. Self-hosted installs leave these empty; billing stays off.
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_TEST_MODE=true                     # use Creem's sandbox API
# CREEM_PRODUCT_PERSONAL_MONTHLY=
# CREEM_PRODUCT_PERSONAL_ANNUAL=
# CREEM_PRODUCT_TEAM_MONTHLY=
# CREEM_PRODUCT_TEAM_ANNUAL=
# BILLING_TRIAL_DAYS=14
# BILLING_FOUNDING_CUTOFF=                 # ISO date; workspaces created on/before keep free access

# Optional custom release image. In production use a published image@sha256 digest.
# KANEO_IMAGE=your-registry/kaneo@sha256:<published-digest>

# Compose service env file; set alongside --env-file when using .env.prod.
# KANEO_ENV_FILE=.env.prod
